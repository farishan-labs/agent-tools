{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["plugins/**/*.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
